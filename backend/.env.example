# Copy to .env and adjust. No secrets are committed to this repo.

# SQLite by default — zero setup. Swap to Postgres/PostGIS for production:
# postgresql+psycopg://user:password@localhost:5432/climatrix
DATABASE_URL=sqlite:///./climatrix.db

# CORS: the Vite dev server origin.
FRONTEND_ORIGIN=http://localhost:5181

# NASA POWER has no API key requirement — this is here only so the
# connector's base URL is not hardcoded across the codebase.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Open-Meteo: free, no key required.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# Real keys for this prototype — rotate before any public deployment.
TOMORROW_IO_API_KEY=
TOMORROW_IO_BASE_URL=https://api.tomorrow.io/v4

NEWSAPI_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2

GNEWS_API_KEY=
GNEWS_BASE_URL=https://gnews.io/api/v4

ALPHAI_API_KEY=
ALPHAI_BASE_URL=https://api.alphai.io/api

# The Copilot's fallback intent classifier: a LOCAL Ollama instance, used
# only for messages its regex rules don't confidently match. No API key —
# install Ollama (https://ollama.com), run `ollama pull llama3.1`, and
# make sure `ollama serve` is running. Unreachable is fine too; the
# Copilot still answers via rules alone, just with less paraphrase
# tolerance.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Background ML anomaly sweep (app/services/scheduler.py) — periodically
# re-runs the weather anomaly detector for every region's hazard
# coordinates instead of only on-demand. Disabled automatically in tests.
ANOMALY_SWEEP_ENABLED=true
ANOMALY_SWEEP_INTERVAL_HOURS=6
