# Copy to .env and adjust. No secrets are committed to this repo.

# SQLite by default — zero setup. Swap to Postgres/PostGIS for production:
# postgresql+psycopg://user:password@localhost:5432/climatrix
DATABASE_URL=sqlite:///./climatrix.db

# CORS: the Vite dev server origin.
FRONTEND_ORIGIN=http://localhost:5181

# NASA POWER has no API key requirement — this is here only so the
# connector's base URL is not hardcoded across the codebase.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
